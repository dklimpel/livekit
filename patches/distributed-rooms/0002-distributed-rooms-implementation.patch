+// limitations under the License.
+
+package distributed
+
+import (
+	"time"
+
+	"github.com/livekit/protocol/livekit"
+
+	"github.com/livekit/livekit-server/pkg/routing/selector"
+)
+
+// nodeCheckWorker detects nodes of the room that died without announcing it
+// (crash, network partition). Their participants are removed from the local
+// room; the affected clients reconnect and are placed on a live node, because
+// the placement ignores participant assignments to dead nodes.
+func (rs *roomState) nodeCheckWorker() {
+	ticker := time.NewTicker(rs.m.conf.NodeCheckInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-rs.ctx.Done():
+			return
+		case <-ticker.C:
+		}
+
+		nodes, err := rs.m.router.ListNodes()
+		if err != nil {
+			rs.logger.Warnw("could not list nodes", err)
+			continue
+		}
+		alive := make(map[livekit.NodeID]bool, len(nodes))
+		for _, n := range nodes {
+			alive[livekit.NodeID(n.Id)] = selector.IsAvailable(n)
+		}
+
+		for _, nodeID := range rs.remoteNodeIDs() {
+			if alive[nodeID] {
+				continue
+			}
+			rs.logger.Warnw("remote node of room is unavailable", nil, "remoteNodeID", nodeID)
+			removed := rs.removeNode(nodeID, "node unavailable")
+			if f := rs.m.onFailedNodeParticipant; f != nil {
+				for _, rp := range removed {
+					f(rs.ctx, rs.room.Name(), rp.lastActiveInfo())
+				}
+			}
+			if _, err := rs.m.store.RemoveNode(rs.ctx, rs.room.Name(), nodeID); err != nil && rs.ctx.Err() == nil {
+				rs.logger.Warnw("could not remove dead node from room", err, "remoteNodeID", nodeID)
+			}
+		}
+	}
+}
+
+func (rs *roomState) remoteNodeIDs() []livekit.NodeID {
+	rs.lock.Lock()
+	defer rs.lock.Unlock()
+	seen := make(map[livekit.NodeID]struct{})
+	var ids []livekit.NodeID
+	add := func(id livekit.NodeID) {
+		if _, ok := seen[id]; !ok {
+			seen[id] = struct{}{}
+			ids = append(ids, id)
+		}
+	}
+	for _, rp := range rs.remote {
+		add(rp.NodeID())
+	}
+	for id := range rs.conns {
+		add(id)
+	}
+	return ids
+}
diff --git a/pkg/distributed/placement.go b/pkg/distributed/placement.go
new file mode 100644
index 0000000000000000000000000000000000000000..2b0558b23fb7b1b9329e5e1af184195c585706d9
--- /dev/null
+++ b/pkg/distributed/placement.go
@@ -0,0 +1,259 @@
+// Copyright 2026 LiveKit, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package distributed
+
+import (
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/redis/go-redis/v9"
+
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/logger"
+
+	"github.com/livekit/livekit-server/pkg/config"
+	"github.com/livekit/livekit-server/pkg/routing"
+	"github.com/livekit/livekit-server/pkg/routing/selector"
+)
+
+type NodeLister interface {
+	ListNodes() ([]*livekit.Node, error)
+}
+
+// Placer decides which node hosts a participant of a distributed room.
+//
+// Strategy "fill, then overflow": a participant is placed on a node that
+// already hosts the room, preferring the fullest node that is still below its
+// limits. Only when all nodes of the room are full, another node of the
+// cluster is added to the room.
+type Placer struct {
+	conf     config.DistributedConfig
+	limits   config.LimitConfig
+	store    *Store
+	rc       redis.UniversalClient
+	nodes    NodeLister
+	selector selector.NodeSelector
+	logger   logger.Logger
+}
+
+var _ routing.ParticipantPlacer = (*Placer)(nil)
+
+func NewPlacer(conf *config.Config, store *Store, rc redis.UniversalClient, nodes NodeLister) (*Placer, error) {
+	sel, err := selector.CreateNodeSelector(conf)
+	if err != nil {
+		return nil, err
+	}
+	return &Placer{
+		conf:     conf.Distributed,
+		limits:   conf.Limit,
+		store:    store,
+		rc:       rc,
+		nodes:    nodes,
+		selector: sel,
+		logger:   logger.GetLogger().WithComponent("distributed"),
+	}, nil
+}
+
+type placementState struct {
+	available  map[livekit.NodeID]*livekit.Node
+	roomNodes  []livekit.NodeID
+	counts     map[livekit.NodeID]int
+	assignment map[livekit.ParticipantIdentity]livekit.NodeID
+}
+
+func (p *Placer) loadState(ctx context.Context, roomName livekit.RoomName) (*placementState, error) {
+	nodes, err := p.nodes.ListNodes()
+	if err != nil {
+		return nil, err
+	}
+	st := &placementState{
+		available: make(map[livekit.NodeID]*livekit.Node),
+		counts:    make(map[livekit.NodeID]int),
+	}
+	for _, n := range selector.GetAvailableNodes(nodes) {
+		st.available[livekit.NodeID(n.Id)] = n
+	}
+
+	st.assignment, err = p.store.GetParticipantNodes(ctx, roomName)
+	if err != nil {
+		return nil, err
+	}
+	for _, nodeID := range st.assignment {
+		st.counts[nodeID]++
+	}
+
+	roomNodes, err := p.store.GetRoomNodes(ctx, roomName)
+	if err != nil {
+		return nil, err
+	}
+	// nodes with assigned participants, which have not created the room yet, are room nodes as well
+	for nodeID := range st.counts {
+		if !slices.Contains(roomNodes, nodeID) {
+			roomNodes = append(roomNodes, nodeID)
+		}
+	}
+	// node allocated by the standard room allocator (e.g. RoomService.CreateRoom)
+	if primary, err := p.rc.HGet(ctx, routing.NodeRoomKey, string(roomName)).Result(); err == nil {
+		if !slices.Contains(roomNodes, livekit.NodeID(primary)) {
+			roomNodes = append(roomNodes, livekit.NodeID(primary))
+		}
+	} else if !errors.Is(err, redis.Nil) {
+		return nil, err
+	}
+	slices.Sort(roomNodes)
+	st.roomNodes = roomNodes
+	return st, nil
+}
+
+// isFull reports whether node can not take another participant of the room.
+func (p *Placer) isFull(node *livekit.Node, roomParticipants int) bool {
+	if p.conf.MaxParticipantsPerNode > 0 && roomParticipants >= p.conf.MaxParticipantsPerNode {
+		return true
+	}
+	if selector.LimitsReached(p.limits, node.Stats) {
+		return true
+	}
+	if p.conf.CPULoadLimit > 0 && node.Stats != nil && node.Stats.CpuLoad > p.conf.CPULoadLimit {
+		return true
+	}
+	return false
+}
+
+// pick returns the node for the next participant of the room.
+func (p *Placer) pick(st *placementState) (*livekit.Node, string, error) {
+	// fill: fullest room node below its limits
+	var best *livekit.Node
+	bestCount := -1
+	for _, nodeID := range st.roomNodes {
+		node := st.available[nodeID]
+		if node == nil {
+			continue
+		}
+		count := st.counts[nodeID]
+		if p.isFull(node, count) {
+			continue
+		}
+		if count > bestCount {
+			best, bestCount = node, count
+		}
+	}
+	if best != nil {
+		return best, "fill", nil
+	}
+
+	// overflow: add another node to the room
+	var candidates []*livekit.Node
+	for nodeID, node := range st.available {
+		if slices.Contains(st.roomNodes, nodeID) {
+			continue
+		}
+		if p.isFull(node, 0) {
+			continue
+		}
+		candidates = append(candidates, node)
+	}
+	if len(candidates) == 0 {
+		return nil, "", routing.ErrNodeLimitReached
+	}
+	node, err := p.selector.SelectNode(candidates)
+	if err != nil {
+		return nil, "", err
+	}
+	if len(st.roomNodes) == 0 {
+		return node, "new", nil
+	}
+	return node, "overflow", nil
+}
+
+// NodeForParticipant selects (and records) the node for a participant.
+// A participant that is already assigned to a live node stays there, so
+// resumes and identity replacements are handled by the node holding the
+// participant's session.
+func (p *Placer) NodeForParticipant(ctx context.Context, roomName livekit.RoomName, pi routing.ParticipantInit) (livekit.NodeID, string, error) {
+	unlock, err := p.store.LockPlacement(ctx, roomName)
+	if err != nil {
+		return "", "", err
+	}
+	defer unlock()
+
+	st, err := p.loadState(ctx, roomName)
+	if err != nil {
+		return "", "", err
+	}
+
+	if nodeID := st.assignment[pi.Identity]; nodeID != "" && st.available[nodeID] != nil {
+		return nodeID, "assigned", nil
+	}
+
+	node, reason, err := p.pick(st)
+	if err != nil {
+		return "", "", err
+	}
+	nodeID := livekit.NodeID(node.Id)
+	if pi.Identity != "" {
+		if err := p.store.SetParticipantNode(ctx, roomName, pi.Identity, nodeID); err != nil {
+			return "", "", err
+		}
+	}
+	// keep upstream routing state pointing to a live node of the room
+	if primary := firstAvailable(st.roomNodes, st.available); primary == "" {
+		if err := p.rc.HSet(ctx, routing.NodeRoomKey, string(roomName), string(nodeID)).Err(); err != nil {
+			return "", "", err
+		}
+	}
+
+	p.logger.Infow(
+		"placed participant",
+		"room", roomName,
+		"participant", pi.Identity,
+		"nodeID", nodeID,
+		"reason", reason,
+		"roomNodes", st.roomNodes,
+		"roomParticipantsOnNode", st.counts[nodeID]+1,
+	)
+	return nodeID, reason, nil
+}
+
+// NodeForRoom returns the node that would host the next participant of the room.
+// It is used where upstream asks for "the" node of a room (room creation, WHIP,
+// limit checks).
+func (p *Placer) NodeForRoom(ctx context.Context, roomName livekit.RoomName) (*livekit.Node, error) {
+	st, err := p.loadState(ctx, roomName)
+	if err != nil {
+		return nil, err
+	}
+	if len(st.roomNodes) == 0 {
+		return nil, routing.ErrNotFound
+	}
+	node, _, err := p.pick(st)
+	if err != nil {
+		// everything is full, report a room node so that callers apply their limit handling
+		if nodeID := firstAvailable(st.roomNodes, st.available); nodeID != "" {
+			return st.available[nodeID], nil
+		}
+		return nil, routing.ErrNotFound
+	}
+	return node, nil
+}
+
+func firstAvailable(nodeIDs []livekit.NodeID, available map[livekit.NodeID]*livekit.Node) livekit.NodeID {
+	for _, nodeID := range nodeIDs {
+		if available[nodeID] != nil {
+			return nodeID
+		}
+	}
+	return ""
+}
diff --git a/pkg/distributed/relayconn.go b/pkg/distributed/relayconn.go
new file mode 100644
index 0000000000000000000000000000000000000000..bee6f777dfd56cae05608ab17bf76d8d58832d06
--- /dev/null
+++ b/pkg/distributed/relayconn.go
@@ -0,0 +1,397 @@
+// Copyright 2026 LiveKit, Inc.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package distributed
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/pion/rtcp"
+	"github.com/pion/webrtc/v4"
+	"go.uber.org/atomic"
+
+	"github.com/livekit/protocol/codecs/mime"
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/logger"
+
+	"github.com/livekit/livekit-server/pkg/sfu"
+	"github.com/livekit/livekit-server/pkg/sfu/buffer"
+	"github.com/livekit/livekit-server/pkg/utils"
+)
+
+const (
+	relaySubscribeRetryInterval = 3 * time.Second
+
+	// a failed sending relay connection is recreated with exponential backoff
+	relayRetryBackoffMin = 3 * time.Second
+	relayRetryBackoffMax = time.Minute
+)
+
+// relayConn is the relay between this node and a peer node for one room.
+//
+// Each direction uses its own peer connection, offered by the sending node:
+//   - receiving: tracks published on the peer, subscribed by local participants
+//   - sending (relaySender): local tracks, subscribed by participants of the peer
+type relayConn struct {
+	rs     *roomState
+	peer   livekit.NodeID
+	logger logger.Logger
+
+	// buffers of tracks received from the peer
+	bufferFactory *buffer.Factory
+
+	lock              sync.Mutex
+	recvPC            *webrtc.PeerConnection
+	recvSession       string
+	pendingCandidates []webrtc.ICECandidateInit
+	requested         map[livekit.TrackID]*remoteTrack
+	sender            *relaySender
+	senderFailures    int
+	senderRetryAt     time.Time
+
+	closed atomic.Bool
+}
+
+func newRelayConn(rs *roomState, peer livekit.NodeID) *relayConn {
+	return &relayConn{
+		rs:            rs,
+		peer:          peer,
+		logger:        rs.logger.WithValues("remoteNodeID", peer),
+		bufferFactory: rs.room.GetBufferFactory(),
+		requested:     make(map[livekit.TrackID]*remoteTrack),
+	}
+}
+
+// pionLogger is the logger for the WebRTC stack of relay connections. It uses
+// the transport component, so that logging.pion_level applies like for
+// participant connections.
+func (c *relayConn) pionLogger() logger.Logger {
+	return logger.GetLogger().WithComponent(utils.ComponentTransport).WithValues(
+		"room", c.rs.room.Name(),
+		"remoteNodeID", c.peer,
+		"relay", true,
+	)
+}
+
+func (c *relayConn) close() {
+	if c.closed.Swap(true) {
+		return
+	}
+	c.lock.Lock()
+	pc := c.recvPC
+	c.recvPC = nil
+	sender := c.sender
+	c.sender = nil
+	c.lock.Unlock()
+
+	if pc != nil {
+		_ = pc.Close()
+	}
+	if sender != nil {
+		sender.close()
+	}
+}
+
+func (c *relayConn) sendToPeer(msg *message) {
+	msg.Node = c.rs.nodeID()
+	msg.Room = c.rs.room.Name()
+	ctx, cancel := context.WithTimeout(c.rs.ctx, publishTimeout)
+	defer cancel()
+	if err := publish(ctx, c.rs.m.bus, nodeChannel(c.peer), msg); err != nil && c.rs.ctx.Err() == nil {
+		c.logger.Warnw("could not send relay message", err, "type", msg.Type)
+	}
+}
+
+// --- receiving side ---
+
+// requestTrack asks the peer to relay a track. The request is repeated until
+// media arrives, which covers lost messages and peers still setting up.
+func (c *relayConn) requestTrack(t *remoteTrack) {
+	c.lock.Lock()
+	c.requested[t.ID()] = t
+	c.lock.Unlock()
+
+	c.logger.Debugw("requesting relayed track", "trackID", t.ID())
+	go func() {
+		for {
+			c.sendToPeer(&message{Type: msgRelaySubscribe, TrackID: t.ID()})
+			select {
+			case <-c.rs.ctx.Done():
+				return
+			case <-time.After(relaySubscribeRetryInterval):
+			}
+			if c.closed.Load() || !t.relayRequested.Load() || len(t.Receivers()) != 0 {
+				return
+			}
+		}
+	}()
+}
+
+func (c *relayConn) releaseTrack(t *remoteTrack) {
+	c.lock.Lock()
+	if c.requested[t.ID()] == t {
+		delete(c.requested, t.ID())
+	}
+	c.lock.Unlock()
+	if !c.closed.Load() {
+		c.sendToPeer(&message{Type: msgRelayUnsubscribe, TrackID: t.ID()})
+	}
+}
+
+func (c *relayConn) writeRTCP(pkts []rtcp.Packet) {
+	c.lock.Lock()
+	pc := c.recvPC
+	c.lock.Unlock()
+	if pc != nil {
+		_ = pc.WriteRTCP(pkts)
+	}
+}
+
+func (c *relayConn) sendSubscribedQualities(trackID livekit.TrackID, codecs []*livekit.SubscribedCodec) {
+	if c.closed.Load() {
+		return
+	}
+	c.sendToPeer(&message{
+		Type:      msgRelayQuality,
+		TrackID:   trackID,
+		Qualities: marshalProto(&livekit.SubscribedQualityUpdate{TrackSid: string(trackID), SubscribedCodecs: codecs}),
+	})
+}
+
+func (c *relayConn) handleOffer(session string, sdp string) {
+	c.lock.Lock()
+	pc := c.recvPC
+	if pc != nil && c.recvSession != session {
+		// the peer restarted its sending side
+		c.logger.Infow("relay session changed, recreating receiving connection")
+		_ = pc.Close()
+		pc = nil
+	}
+	if pc == nil {
+		var err error
+		pc, err = c.rs.m.relay.newPeerConnection(c.rs.room.ToProto().EnabledCodecs, c.bufferFactory, true, c.pionLogger())
+		if err != nil {
+			c.lock.Unlock()
+			c.logger.Errorw("could not create receiving relay connection", err)
+			return
+		}
+		c.recvPC = pc
+		c.recvSession = session
+		c.pendingCandidates = nil
+		pc.OnTrack(c.onTrack)
+		pc.OnICECandidate(func(cand *webrtc.ICECandidate) {
+			if cand == nil {
+				return
+			}
+			data, _ := json.Marshal(cand.ToJSON())
+			c.sendToPeer(&message{Type: msgRelayCandidate, Candidate: string(data), ToSender: true, SessionID: session})
+		})
+		pc.OnConnectionStateChange(func(state webrtc.PeerConnectionState) {
+			c.logger.Debugw("receiving relay connection state changed", "state", state)
+			if state == webrtc.PeerConnectionStateFailed {
+				c.logConnectionFailed("receiving")
+			}
+		})
+	}
+	c.lock.Unlock()
+
+	if err := pc.SetRemoteDescription(webrtc.SessionDescription{Type: webrtc.SDPTypeOffer, SDP: sdp}); err != nil {
+		c.logger.Errorw("could not set relay offer", err)
+		return
+	}
+
+	c.lock.Lock()
+	pending := c.pendingCandidates
+	c.pendingCandidates = nil
+	c.lock.Unlock()
+	for _, cand := range pending {
+		_ = pc.AddICECandidate(cand)
+	}
+
+	answer, err := pc.CreateAnswer(nil)
+	if err != nil {
+		c.logger.Errorw("could not create relay answer", err)
+		return
+	}
+	if err := pc.SetLocalDescription(answer); err != nil {
+		c.logger.Errorw("could not set relay answer", err)
+		return
+	}
+	c.sendToPeer(&message{Type: msgRelayAnswer, SDP: answer.SDP, SessionID: session})
+}
+
+func (c *relayConn) addRecvCandidate(session string, candidate string) {
+	var cand webrtc.ICECandidateInit
+	if err := json.Unmarshal([]byte(candidate), &cand); err != nil {
+		return
+	}
+	c.lock.Lock()
+	pc := c.recvPC
+	if pc == nil || c.recvSession != session || pc.RemoteDescription() == nil {
+		c.pendingCandidates = append(c.pendingCandidates, cand)
+		c.lock.Unlock()
+		return
+	}
+	c.lock.Unlock()
+	_ = pc.AddICECandidate(cand)
+}
+
+// relayed streams are identified by "<trackID>|<mime>|<stream index>"
+func relayStreamID(trackID livekit.TrackID, mimeType mime.MimeType, idx int) string {
+	return fmt.Sprintf("%s|%s|%d", trackID, mimeType, idx)
+}
+
+func parseRelayStreamID(id string) (livekit.TrackID, mime.MimeType, int, bool) {
+	parts := strings.Split(id, "|")
+	if len(parts) != 3 {
+		return "", mime.MimeTypeUnknown, 0, false
+	}
+	idx, err := strconv.Atoi(parts[2])
+	if err != nil {
+		return "", mime.MimeTypeUnknown, 0, false
+	}
+	return livekit.TrackID(parts[0]), mime.NormalizeMimeType(parts[1]), idx, true
+}
+
+func (c *relayConn) onTrack(track *webrtc.TrackRemote, receiver *webrtc.RTPReceiver) {
+	trackID, mimeType, idx, ok := parseRelayStreamID(track.ID())
+	if !ok {
+		c.logger.Warnw("unexpected relayed track", nil, "id", track.ID())
+		return
+	}
+
+	c.lock.Lock()
+	t := c.requested[trackID]
+	c.lock.Unlock()
+	if t == nil {
+		c.logger.Infow("relayed track not requested anymore", "trackID", trackID)
+		return
+	}
+
+	// simulcast streams are mapped back to the RID of their layer
+	rid := ""
+	if idx > 0 || len(buffer.GetVideoLayersForMimeType(mimeType, t.ToProto())) > 1 {
+		for _, l := range buffer.GetVideoLayersForMimeType(mimeType, t.ToProto()) {
+			if int(l.SpatialLayer) == idx {
+				rid = l.Rid
+				break
+			}
+		}
+	}
+
+	mid := ""
+	for _, tr := range c.recvPCTransceivers() {
+		if tr.Receiver() == receiver {
+			mid = tr.Mid()
+			break
+		}
+	}
+
+	c.logger.Debugw("relayed track received", "trackID", trackID, "mime", mimeType, "stream", idx, "rid", rid, "ssrc", track.SSRC())
+	if _, ok := t.MediaTrack.AddReceiver(receiver, &relayTrackRemote{TrackRemote: track, rid: rid}, mid); !ok {
+		c.logger.Warnw("could not add relayed receiver", nil, "trackID", trackID, "mime", mimeType, "stream", idx)
+	}
+}
+
+func (c *relayConn) recvPCTransceivers() []*webrtc.RTPTransceiver {
+	c.lock.Lock()
+	pc := c.recvPC
+	c.lock.Unlock()
+	if pc == nil {
+		return nil
+	}
+	return pc.GetTransceivers()
+}
+
+// --- sending side ---
+
+func (c *relayConn) getOrCreateSender() *relaySender {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+	if c.closed.Load() {
+		return nil
+	}
+	if c.sender != nil && c.sender.isFailed() {
+		c.sender.close()
+		c.sender = nil
+		c.senderFailures++
+		backoff := relayRetryBackoffMin << min(c.senderFailures-1, 5)
+		if backoff > relayRetryBackoffMax {
+			backoff = relayRetryBackoffMax
+		}
+		c.senderRetryAt = time.Now().Add(backoff)
+		c.logger.Infow("retrying sending relay connection later", "failures", c.senderFailures, "backoff", backoff)
+	}
+	if c.sender == nil && time.Now().Before(c.senderRetryAt) {
+		// the peer repeats its subscription requests until the relay works
+		return nil
+	}
+	if c.sender == nil {
+		s, err := newRelaySender(c)
+		if err != nil {
+			c.logger.Errorw("could not create sending relay connection", err)
+			return nil
+		}
+		c.sender = s
+	}
+	return c.sender
+}
+
+func (c *relayConn) onSenderConnected() {
+	c.lock.Lock()
+	failures := c.senderFailures
+	c.senderFailures = 0
+	c.senderRetryAt = time.Time{}
+	c.lock.Unlock()
+	if failures > 0 {
+		c.logger.Infow("sending relay connection established after failures", "failures", failures)
+	}
+}
+
+// logConnectionFailed explains the most likely cause of a failed relay connection.
+func (c *relayConn) logConnectionFailed(direction string) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	remote, _ := c.rs.m.store.GetNodeRelayAddress(ctx, c.peer)
+	c.logger.Warnw(
+		"relay connection to remote node failed, nodes must reach each other on the relay UDP port range", nil,
+		"direction", direction,
+		"localRelayAddress", c.rs.m.relay.address(),
+		"remoteRelayAddress", remote,
+		"hint", "check firewall rules for distributed.relay.port_range_start..port_range_end and distributed.relay.node_ip / "+RelayNodeIPEnv,
+	)
+}
+
+func (c *relayConn) getSender() *relaySender {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+	return c.sender
+}
+
+// relayTrackRemote presents a relayed stream with the RID of its simulcast layer.
+type relayTrackRemote struct {
+	*webrtc.TrackRemote
+	rid string
+}
+
+var _ sfu.TrackRemote = (*relayTrackRemote)(nil)
+
+func (t *relayTrackRemote) RID() string                   { return t.rid }
+func (t *relayTrackRemote) RTCTrack() *webrtc.TrackRemote { return t.TrackRemote }
